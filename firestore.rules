rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Subject classes (e.g. classes/calc). Scores written only by Admin/API.
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if false;

      match /students/{studentId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == studentId;
        allow delete: if false;
      }

      match /weeks/{weekId} {
        allow read: if signedIn();
        allow write: if false;

        match /standings/{studentId} {
          allow read: if signedIn();
          allow write: if false;
        }

        match /bestScores/{docId} {
          allow read: if signedIn() && (
            resource.data.studentId == request.auth.uid
          );
          allow write: if false;
        }
      }

      match /winners/{weekId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /attempts/{attemptId} {
        allow read: if signedIn() && resource.data.uid == request.auth.uid;
        allow write: if false;
      }

      match /flaggedScores/{flagId} {
        allow read: if false;
        allow write: if false;
      }
    }
  }
}
